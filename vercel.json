{
  "framework": "vite",
  "installCommand": "echo @kietvpt:registry=https://npm.pkg.github.com > .npmrc && echo //npm.pkg.github.com/:_authToken=$GITHUB_TOKEN >> .npmrc && npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
